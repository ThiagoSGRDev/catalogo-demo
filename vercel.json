{
  "rewrites": [
    {
      "source": "/",
      "missing": [
        {
          "type": "host",
          "value": "katalogohub\\.com"
        },
        {
          "type": "host",
          "value": "www\\.katalogohub\\.com"
        },
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        },
        {
          "type": "host",
          "value": "localhost"
        }
      ],
      "destination": "/catalogo-template.html"
    },
    {
      "source": "/((?!api/|.*\\.).*)",
      "missing": [
        {
          "type": "host",
          "value": "katalogohub\\.com"
        },
        {
          "type": "host",
          "value": "www\\.katalogohub\\.com"
        },
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        },
        {
          "type": "host",
          "value": "localhost"
        }
      ],
      "destination": "/catalogo-template.html"
    },
    {
      "source": "/catalogo/loja/:slug",
      "destination": "/catalogo-template.html"
    },
    {
      "source": "/catalogo/loja/:slug/:path*",
      "destination": "/catalogo-template.html"
    },
    {
      "source": "/loja/:slug",
      "destination": "/catalogo-template.html"
    },
    {
      "source": "/loja/:slug/:path*",
      "destination": "/catalogo-template.html"
    },
    {
      "source": "/catalogo/loja/:slug/",
      "destination": "/catalogo-template.html"
    },
    {
      "source": "/loja/:slug/",
      "destination": "/catalogo-template.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/dashboard/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "/dashboard/",
      "permanent": true
    }
  ]
}
